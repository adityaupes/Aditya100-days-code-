Q41: Write a program to swap the first and last digit of a number.

/*
Sample Test Cases:
Input 1:
1234
Output 1:
4231

Input 2:
1001
Output 2:
1001

*/
#include <stdio.h>

int main() {
    int n, first, last, power = 1, temp, result;

    scanf("%d", &n);

    if (n < 10) {
        printf("%d", n);
        return 0;
    }

    temp = n;

    // Find the last digit
    last = n % 10;

    // Find the first digit and power of 10
    while (temp >= 10) {
        temp /= 10;
        power *= 10;
    }

    first = temp;

    // Swap first and last digits
    result = n - (first * power) - last;
    result = result + (last * power) + first;

    printf("%d", result);

    return 0;
}

